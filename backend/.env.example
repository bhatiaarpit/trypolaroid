# Supabase transaction pooler URL used by the running backend (port 6543).
# Keep pgbouncer=true when using Prisma through Supabase's pooler.
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase direct/session URL used by Prisma migrations and schema commands (port 5432).
DIRECT_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"

# Secret used to sign and verify JWTs.
JWT_SECRET="replace-with-a-long-random-secret"

# Google OAuth client identifier.
GOOGLE_CLIENT_ID="your-google-client-id"

# Google OAuth client secret.
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Supabase project URL for file storage.
SUPABASE_URL="https://your-project.supabase.co"

# Supabase service role key used for server-side storage access.
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Private Storage bucket for original user photos.
SUPABASE_PHOTOS_BUCKET="polaroid-photos"

# Private Storage bucket for generated Polaroid outputs.
SUPABASE_OUTPUTS_BUCKET="polaroid-outputs"

# Replicate API token used for image generation.
REPLICATE_API_TOKEN="your-replicate-api-token"

# OpenAI API key used for text moderation.
OPENAI_API_KEY="your-openai-api-key"

# Port used by the Express backend.
PORT=5000
